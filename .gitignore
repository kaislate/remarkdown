# Internal development docs — kept local only, never pushed to GitHub.
# Specs, plans, QA notes, project-state snapshots, and end-of-session
# thoughts documents all live under docs/ for local reference only.
# RELEASING.md and any other docs intended to ship live at the repo root.
docs/

# Annotation sidecars from manual QA on local files — never pushed.
*.remarkdown.json

# Updater signing keys — should always live OUTSIDE the repo (default
# location is ~/.tauri/), but defensive ignore in case someone drops a
# copy in the project tree.
*.key
*.key.pub
*.password
.env
.env.local

# Generated updater manifest — built per-release by scripts/build-manifest.mjs
# and uploaded as a GitHub release asset. Re-built every release; not
# checked in.
latest.json
