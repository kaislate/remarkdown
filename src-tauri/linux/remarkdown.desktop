# Upstream tauri-bundler template (tauri-cli-v2.12.4) with %F on Exec so file managers pass the file, and a trailing ; on MimeType (the bundler joins types with ; but adds none after the last, and the spec wants one).
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}};
{{/if}}
