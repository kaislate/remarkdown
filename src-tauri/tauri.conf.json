{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "remarkdown",
  "version": "0.4.1",
  "identifier": "com.remarkdown.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1566",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "remarkdown",
        "width": 1100,
        "height": 780,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
